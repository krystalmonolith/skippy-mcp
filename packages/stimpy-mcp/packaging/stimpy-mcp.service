# StimpyMCP server — drives GPIO directly via the kernel chardev (lgpio, no daemon).
# Install to /etc/systemd/system/stimpy-mcp.service, then:
#   sudo systemctl enable --now stimpy-mcp
# Edit User and the bind address/config path for your Pi.
[Unit]
Description=StimpyMCP GPIO digital-stimulus MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stimpy
Group=stimpy
# lgpio talks to /dev/gpiochipN; the user must be in the 'gpio' group.
SupplementaryGroups=gpio
DeviceAllow=/dev/gpiochip0 rw
# REQUIRED: the lgpio Python module creates .lgd-nfy* notify FIFOs in its CWD on
# import. A system service's default CWD is / (not writable) -> startup crash
# ("xCreatePipe: Can't set permissions for //.lgd-nfy0"). Give it a writable,
# service-private state dir (auto-created/owned by systemd, RW under ProtectSystem).
StateDirectory=stimpy-mcp
WorkingDirectory=/var/lib/stimpy-mcp
# Bind all interfaces (0.0.0.0): robust to DHCP lease changes (a literal IP that
# drifts off the interface => bind failure => crash-loop) and auto-covers eth0
# when the bench net returns. Safe here because api_key auth + the config's
# DNS-rebinding allowed_hosts gate access; api_key (+ optional TLS) live in the
# config (mode 0600). To confine the server to one interface, set a literal IP.
ExecStart=/opt/stimpy-mcp/venv/bin/stimpy-mcp \
    --bind 0.0.0.0 \
    --port 8080 \
    --config /etc/stimpy-mcp/config.json \
    --allow-builtin-patterns
Restart=on-failure
RestartSec=2
# Allow best-effort SCHED_FIFO pacing for low frame jitter (optional but recommended).
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
LimitRTPRIO=20
# Hardening (the server needs no other privileges):
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/stimpy-mcp

[Install]
WantedBy=multi-user.target
